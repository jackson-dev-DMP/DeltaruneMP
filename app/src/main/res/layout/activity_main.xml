<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#121212">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DeltaruneMP Launcher v1.1.6"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Container Profile"
        android:textColor="#AAAAAA"
        android:textSize="14sp" />

    <Spinner
        android:id="@+id/containerSpinner"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Touch Controls Profile (.ICP)"
        android:textColor="#AAAAAA"
        android:textSize="14sp" />

    <Spinner
        android:id="@+id/icpSpinner"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/launchButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="LAUNCH DELTARUNEMP"
        android:textSize="16sp"
        android:backgroundTint="#6200EE"
        android:textColor="#FFFFFF" />

</LinearLayout>
